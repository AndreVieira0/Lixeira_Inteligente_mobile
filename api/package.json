{
  "name": "lixeira-inteligente-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/app.test.ts",
    "test:integration": "tsx --test tests/integration.test.ts",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate-cli.ts"
  }
}
