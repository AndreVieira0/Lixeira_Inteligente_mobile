{
  "name": "lixeira-inteligente-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/native": "^7.4.1",
    "expo": "~57.0.24",
    "expo-font": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "firebase": "^12.19.0",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.3",
    "react-native-paper": "^5.15.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "scripts": {
    "test": "node --require ./tests/register.cjs --test tests/*.test.cjs",
    "test:integration": "node --require ./tests/register.cjs --test tests/integration/*.test.cjs",
    "test:emulators": "npx firebase-tools emulators:exec --config ../firebase/firebase.json --project demo-lixeira-inteligente --only auth,firestore \"npm run test:integration\"",
    "test:e2e": "npx firebase-tools emulators:exec --config ../firebase/firebase.json --project demo-lixeira-inteligente --only auth,firestore \"playwright test --config tests/e2e/playwright.config.cjs\"",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor"
  },
  "private": true
}
