{
  "name": "lixeira-inteligente-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/native": "^7.4.1",
    "expo": "~58.0.0",
    "expo-font": "~58.0.10",
    "expo-status-bar": "~58.0.4",
    "firebase": "^12.19.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-paper": "^5.15.3",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "victory-native": "^36.9.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.64.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "firebase-admin": "^14.5.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "scripts": {
    "test": "node --require ./tests/register.cjs --test tests/*.test.cjs",
    "test:integration": "node --require ./tests/register.cjs --test tests/integration/*.test.cjs",
    "test:emulators": "npx firebase-tools emulators:exec --config ../firebase/firebase.json --project demo-lixeira-inteligente --only auth,firestore \"npm run test:integration\"",
    "test:e2e": "npx firebase-tools emulators:exec --config ../firebase/firebase.json --project demo-lixeira-inteligente --only auth,firestore \"playwright test --config tests/e2e/playwright.config.cjs\"",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor"
  },
  "private": true
}
