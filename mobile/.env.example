# Lixeira Inteligente — variáveis de ambiente
# Copie este arquivo para `.env.development` e `.env.production` e preencha os valores reais.
# NUNCA versione valores reais. Apenas variáveis com o prefixo EXPO_PUBLIC_ são expostas ao app.

# Ambiente
EXPO_PUBLIC_ENVIRONMENT=development
EXPO_PUBLIC_APP_MODE=demo

# Firebase (Authentication, Firestore, Cloud Messaging)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Opcional: somente desenvolvimento, com projectId demo-lixeira-inteligente.
# Android Emulator: 10.0.2.2. Navegador: 127.0.0.1. Celular físico: IP do computador.
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=false
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=
