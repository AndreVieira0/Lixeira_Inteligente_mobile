# Lixeira Inteligente — variáveis de ambiente
# Copie este arquivo para `.env.development` e `.env.production` e preencha os valores reais.
# NUNCA versione valores reais. Apenas variáveis com o prefixo EXPO_PUBLIC_ são expostas ao app.

# Ambiente
EXPO_PUBLIC_ENVIRONMENT=development

# Firebase (Authentication, Firestore, Cloud Messaging)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=